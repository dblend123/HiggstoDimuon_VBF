universe = vanilla
executable = sync_jobs/run_sync_v6.sh

arguments = VBF $(CHUNK)

output = sync_jobs/logs/vbf_retry_v6.$(CHUNK).$(ClusterId).out
error  = sync_jobs/logs/vbf_retry_v6.$(CHUNK).$(ClusterId).err
log    = sync_jobs/logs/vbf_retry_v6.$(ClusterId).log

getenv = True
should_transfer_files = NO

use_x509userproxy = True
