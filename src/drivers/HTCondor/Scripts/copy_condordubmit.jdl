arguments               = $(inputList) $(tag)
executable              = run_job.sh
output                  = /afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/HTCondor/logs/$(tag)_$(ClusterId).out
error                   = /afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/HTCondor/logs/$(tag)_$(ClusterId).err
log                     = /afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/HTCondor/logs/$(tag)_$(ClusterId).log
use_x509userproxy       = true
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = process_HiggsAnalysis_wCutsExtended_NoPairing_v0, run_job.sh, $(inputList), x509up.cert
x509userproxy           = x509up.cert
transfer_output_files   = DY_MCPileup_${tag}.root, output_$(tag).root 
transfer_output_remaps  = "DY_MCPileup_$(tag).root=/afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/HTCondor/outputs/DY_MCPileup_$(tag).root", "output_$(tag).root=/afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/HTCondor/outputs/output_$(tag).root"
+JobFlavour             = "tomorrow"
queue inputList, tag from DY_input_files.txt
# queue inputList, tag from Signal_input_lists.txt
# queue inputList, tag from Data_input_lists.txt
