int dirExists(const char*  path)
{
    struct stat info;

    int statRC = stat( path, &info );
    if( statRC != 0 )
    {
        if (errno == ENOENT)  { return 0; } 
        if (errno == ENOTDIR) { return 0; } 
        return -1;
    }

    return ( info.st_mode & S_IFDIR ) ? 1 : 0;
}
