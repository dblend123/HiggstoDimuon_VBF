arguments = $(inputList) $(tag) $(sample) $(era)

executable              = Skim_run_job.sh
output                  = outs/$(tag)_$(ClusterId).out
error                   = errors/$(tag)_$(ClusterId).err
log                     = logs/$(tag)_$(ClusterId).log

stream_output           = True
stream_error            = True

use_x509userproxy       = true
x509userproxy           = x509up.cert

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files  = ""

transfer_input_files    = my_skim, Skim_run_job.sh, $(inputList), x509up.cert

# Pass OUTDIR to the wrapper without changing the arg list
# environment             = "OUTDIR=$(outdir)"

# Override site-injected constraints (we use file transfer; AFS/CVMFS on worker not required)
+CvmfsCustomExpression  = true
+PreCvmfsRequirements   = True
+PreAfsRequirements     = True
+PreLocalRequirements   = True

requirements = (OpSysAndVer == "AlmaLinux9")

# Prefer short share to start faster
Rank = regexp("shareshort", TARGET.Hostgroup)

# Survive temporary disconnects
job_lease_duration = 7200

+JobFlavour             = "tomorrow"
request_cpus            = 1
request_memory          = 2000
request_disk            = 4000

era       = 2024
# era       = X
# era       = X
# era       = X

# Base path to listfiles
path = /afs/cern.ch/user/d/dblend/test-analysis/src/drivers/1_ListFiles/$(era)/Condor_listfiles

