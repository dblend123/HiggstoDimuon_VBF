# Args: $1=inputList $2=tag $3=sample $4=weights $5=maxEvents
arguments               = $(inputList) $(tag) $(sample) $(weights) $(maxEvents) $(era)

executable              = run_job.sh
output                  = HTCondor/outs/$(tag)_$(ClusterId).out
error                   = HTCondor/errors/$(tag)_$(ClusterId).err
log                     = HTCondor/logs/$(tag)_$(ClusterId).log

stream_output           = False
stream_error            = False

use_x509userproxy       = true
x509userproxy           = x509up.cert

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files  = ""

# Fixed path to your weights file
weights                 = weights.ini

# Transfer everything needed
transfer_input_files    = process_HiggsAnalysis_wCutsExtended_NoPairing_v0, run_job.sh, $(inputList), x509up.cert, $(weights)

# IMPORTANT: outputs are xrdcp'ed to EOS inside the job
# (leave these commented to avoid HOLDs)
# transfer_output_files   = $(tag).root
# transfer_output_remaps  = "$(tag).root=/eos/user/d/dblend/Analyzed_SkimmedRun22CD/$(outdir)/$(sample)/$(tag).root"

# Pass OUTDIR to the wrapper without changing the arg list
environment             = "OUTDIR=$(outdir)"

# Override site-injected constraints (we use file transfer; AFS/CVMFS on worker not required)
+CvmfsCustomExpression  = true
+PreCvmfsRequirements   = True
+PreAfsRequirements     = True
+PreLocalRequirements   = True

# Wider pool (no AlmaLinux-only gate)
Requirements = (TARGET.OpSys == "LINUX") && (TARGET.Arch == "X86_64") && (TARGET.HasFileTransfer =?= true)

# Prefer short share to start faster
Rank = regexp("shareshort", TARGET.Hostgroup)

# Survive temporary disconnects
job_lease_duration = 7200

+JobFlavour             = "tomorrow"
request_cpus            = 1
request_memory          = 2000
request_disk            = 4000

maxEvents = -1
era       = 12022
# era       = 22022
# era       = 12023
# era       = 22023

# Base path to listfiles
path = /afs/cern.ch/user/d/dblend/test-analysis/src/drivers/1_ListFiles/$(era)/Condor_listfiles/Skimmed_input_lists/

