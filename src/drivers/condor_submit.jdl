# Args: $1=inputList $2=tag $3=sample $4=weights $5=maxEvents $6=era $7=muCorr 
arguments  = $(inputList) $(tag) $(sample) $(weights) $(maxEvents) $(era) $(muCorr) $(noPU) $(noScaleSmear) $(noMuonSF) $(noJERC) $(noJER) $(noJetVeto) $(noGolden) $(noFlags) $(noFSR) $(noBtagSF) $(noJetCriteria) $(noZPtRW) $(zptRWFile) $(btagEffFile) $(noBeamConstraint)

executable              = run_job.sh
output                  = HTCondor/outs/$(tag)_$(ClusterId).out
error                   = HTCondor/errors/$(tag)_$(ClusterId).err
log                     = HTCondor/logs/$(tag)_$(ClusterId).log

stream_output           = False
stream_error            = False

use_x509userproxy       = true
x509userproxy           = x509up.cert

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files  = ""

# Fixed path to your additional files
weights                 = weights.ini

# Uncomment for NO ZptRW and BTagRW Files 
#zptRWFile               = None 
#btagEffFile             = None
#transfer_input_files    = process_HiggsAnalysis_wCutsExtended_NoPairing_v0, run_job.sh, $(inputList), x509up.cert, $(weights)

# Uncomment for ZptRW and BTagRW Files 
zptRWFile               = /afs/cern.ch/user/d/dblend/test-analysis/src/drivers/7_Corrections/ZptReweight/ZPtSF_Fits_$(era).root
btagEffFile             = /afs/cern.ch/user/d/dblend/test-analysis/src/drivers/7_Corrections/JME/BTagEffMaps_$(era).root
transfer_input_files    = process_HiggsAnalysis_wCutsExtended_NoPairing_v0, run_job.sh, $(inputList), x509up.cert, $(weights), $(zptRWFile), $(btagEffFile)

# Pass OUTDIR to the wrapper without changing the arg list
environment             = "OUTDIR=$(outdir)"

# Override site-injected constraints (we use file transfer; AFS/CVMFS on worker not required)
+CvmfsCustomExpression  = true
+PreCvmfsRequirements   = True
+PreAfsRequirements     = True
+PreLocalRequirements   = True

# Wider pool (no AlmaLinux-only gate)
Requirements = (TARGET.OpSys == "LINUX") && (TARGET.Arch == "X86_64") && (TARGET.HasFileTransfer =?= true)

# Prefer short share to start faster
Rank = regexp("shareshort", TARGET.Hostgroup)

# Survive temporary disconnects
job_lease_duration = 7200

+JobFlavour             = "tomorrow"
request_cpus            = 1
request_memory          = 2000
request_disk            = 4000

maxEvents   	    = -1
# muCorr options: kit, roch, none
muCorr             = kit
# true --> Will not run corrections 
noJER             = true
noJERC             = true
noJetCriteria             = false
noJetVeto             = false
noBtagSF             = true
noScaleSmear             = true
noBeamConstraint             = false
noZPtRW             = true
noMuonSF             = false
noFSR             = false
noPU             = false
noGolden             = false
noFlags             = false
era             = 12022

# Base path to listfiles
path = /afs/cern.ch/user/d/dblend/test-analysis/src/drivers/1_ListFiles/$(era)/Condor_listfiles/Skimmed_input_lists/

