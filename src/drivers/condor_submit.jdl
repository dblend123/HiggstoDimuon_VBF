arguments               = $(inputList) $(tag)
executable              = run_job.sh
output                  = /afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/HTCondor/logs/$(tag)_$(ClusterId).out
error                   = /afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/HTCondor/logs/$(tag)_$(ClusterId).err
log                     = /afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/HTCondor/logs/$(tag)_$(ClusterId).log
use_x509userproxy       = true
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = process_HiggsAnalysis_wCutsExtended_NoPairing_v0, run_job.sh, $(inputList), x509up.cert
x509userproxy           = x509up.cert
# transfer_output_files   = output_$(tag).root 
transfer_output_remaps  = "output_$(tag).root=/afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/HTCondor/outputs/Data/$(tag).root"
transfer_output_remaps  = "output_$(tag).root=/afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/HTCondor/outputs/MC/$(tag).root"
+JobFlavour             = "tomorrow"
path = /afs/cern.ch/user/d/dblend/test-analysis/build/src/drivers/1_ListFiles/2022/Condor_listfiles
