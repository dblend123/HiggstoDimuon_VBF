# maxEvents = -1
# queue inputList, tag from $(path)/WZto3LNu_input_lists.txt

# # ZZ->2L2Nu
sample    = ZZto2L2Nu
outdir    = MC
maxEvents = -1
queue inputList, tag from $(path)/ZZto2L2Nu_input_lists.txt

